<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/splash_bg"
    android:padding="24dp">

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Center Composition mimicking the Figma illustration -->
    <RelativeLayout
        android:layout_width="260dp"
        android:layout_height="220dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp">

        <!-- Decorative background dots/sparkles -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_logo_taskflow"
            android:alpha="0.15"
            android:contentDescription="@null" />

        <!-- Key Icon Chip -->
        <View
            android:id="@+id/chip_key"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip_green" />
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignStart="@id/chip_key"
            android:layout_alignTop="@id/chip_key"
            android:layout_marginStart="9dp"
            android:layout_marginTop="9dp"
            android:src="@drawable/ic_settings"
            app:tint="#15803D"
            android:contentDescription="@null" />

        <!-- Settings Gear Chip -->
        <View
            android:id="@+id/chip_gear"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentStart="true"
            android:layout_below="@id/chip_key"
            android:layout_marginStart="20dp"
            android:layout_marginTop="25dp"
            android:background="@drawable/bg_chip_grey" />
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignStart="@id/chip_gear"
            android:layout_alignTop="@id/chip_gear"
            android:layout_marginStart="9dp"
            android:layout_marginTop="9dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="@null" />

        <!-- Hand Drawing Main Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="140dp"
            android:layout_height="100dp"
            android:layout_centerInParent="true"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/navy"
            app:cardElevation="0dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:padding="20dp"
                android:src="@drawable/ic_logo_taskflow"
                android:contentDescription="@null" />
        </androidx.cardview.widget.CardView>

        <!-- Lock Chip -->
        <View
            android:id="@+id/chip_lock"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="45dp"
            android:layout_marginBottom="25dp"
            android:background="@drawable/bg_chip_green" />
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignStart="@id/chip_lock"
            android:layout_alignTop="@id/chip_lock"
            android:layout_marginStart="9dp"
            android:layout_marginTop="9dp"
            android:src="@drawable/ic_folder"
            app:tint="#15803D"
            android:contentDescription="@null" />

        <!-- Cart Chip -->
        <View
            android:id="@+id/chip_cart"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_toEndOf="@id/chip_lock"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="30dp"
            android:layout_marginBottom="25dp"
            android:background="@drawable/bg_chip_grey" />
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignStart="@id/chip_cart"
            android:layout_alignTop="@id/chip_cart"
            android:layout_marginStart="9dp"
            android:layout_marginTop="9dp"
            android:src="@drawable/ic_home"
            android:contentDescription="@null" />

        <!-- Heart Chip -->
        <View
            android:id="@+id/chip_heart"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="15dp"
            android:background="@drawable/bg_chip_green" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tv_splash_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:text="Management of a project will be easier if it is done well"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold"
        android:lineSpacingMultiplier="1.2" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btn_get_started"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_button_dark"
        android:text="Get Started"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:elevation="0dp"
        android:stateListAnimator="@null" />

</LinearLayout>