<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/et_project_tag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_project_tag"
        android:inputType="text"
        android:maxLines="1" />

    <EditText
        android:id="@+id/et_project_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/hint_project_name"
        android:inputType="text"
        android:maxLines="1" />

    <EditText
        android:id="@+id/et_project_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="top|start"
        android:hint="@string/hint_project_description"
        android:inputType="textMultiLine"
        android:minLines="3" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Attachment"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_pick_att_1"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_pick_attachment_selected"
            android:padding="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/img_attachment_1"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Attachment option 1" />

        <ImageView
            android:id="@+id/iv_pick_att_2"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_attachment"
            android:padding="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/img_attachment_2"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Attachment option 2" />

        <ImageView
            android:id="@+id/iv_pick_att_3"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_attachment"
            android:padding="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/img_attachment_3"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Attachment option 3" />

    </LinearLayout>

</LinearLayout>
