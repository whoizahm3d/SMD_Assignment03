<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_card"
            android:contentDescription="@string/cancel"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="#FEE2E2"
                    android:gravity="center"
                    android:text="JD"
                    android:textColor="#DC2626"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="-8dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="#E0E7FF"
                    android:gravity="center"
                    android:text="AL"
                    android:textColor="#4F46E5"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="-8dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="#DCFCE7"
                    android:gravity="center"
                    android:text="MK"
                    android:textColor="#15803D"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_primary"
                android:clickable="false"
                android:focusable="false"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/invite"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Tag & Name -->
    <TextView
        android:id="@+id/tv_project_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_chip_purple"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="Tag"
        android:textColor="@color/chip_purple_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_project_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:text="Project Name"
        android:textColor="@color/text_primary"
        android:textSize="24sp" />

    <!-- TabLayout -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:tabIndicatorColor="@color/primary_blue"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="@color/primary_blue"
        app:tabTextAppearance="@style/TabTextAppearance"
        app:tabTextColor="@color/text_muted" />

    <!-- ViewPager2 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
