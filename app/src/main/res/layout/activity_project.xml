<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:background="@drawable/bg_card"
                android:src="@drawable/ic_back"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Avatars placeholders -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_profile"
                    android:contentDescription="@null" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="-6dp"
                    android:src="@drawable/ic_profile"
                    android:contentDescription="@null" />

                <Button
                    android:id="@+id/btn_invite_top"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/bright_blue"
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    app:backgroundTint="@color/bright_blue"
                    app:cornerRadius="16dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:gravity="center"
                    android:text="Invite"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null"
                    style="@style/Widget.MaterialComponents.Button" />

            </LinearLayout>

        </RelativeLayout>

        <TextView
            android:id="@+id/tv_project_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_grey"
            android:text="UI/UX"
            android:textColor="@color/chip_grey_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_project_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Project name"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_project_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Project description"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/ll_attachments_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_attachment_1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_attachment"
                android:scaleType="centerCrop"
                android:src="@drawable/img_attachment_1"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Attachment 1" />

            <ImageView
                android:id="@+id/iv_attachment_2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_attachment"
                android:scaleType="centerCrop"
                android:src="@drawable/img_attachment_2"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Attachment 2" />

            <TextView
                android:id="@+id/tv_attachment_more"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_attachment"
                android:gravity="center"
                android:text="+2"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:background="@color/stroke_light" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tv_today_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="@string/today_task"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_add_task"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_button_dark"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/add_task"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:stateListAnimator="@null" />

        </RelativeLayout>

        <LinearLayout
            android:id="@+id/ll_task_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="12dp" />

    </LinearLayout>

</ScrollView>
